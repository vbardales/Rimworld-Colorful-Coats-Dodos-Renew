<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!--
    PatchOperationFindMod matches on a mod's display NAME, not its packageId
    (Verse.ModLister.HasActiveModWithName). The Extinct Animals pack has been published under
    four names over its life, and every one of them still exists in somebody's mod folder, so
    all four are listed. The 1.6 one is "ReGrowth: Extinct Animals (Continued)".

    Two operations rather than four, because the defName is what actually differs: the original
    Helixien pack called the bird RG-EAP_Dodo, and every later release calls it RG_Dodo. Listing
    the three RG_Dodo names in one <mods> block also stops the patch from being applied twice
    when two of them are active at once, which would leave the def with two alternateGraphics
    lists.
  -->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>ReGrowth: Extinct Animals Pack</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>/Defs/PawnKindDef[defName = "RG-EAP_Dodo"]</xpath>
          <value>
            <alternateGraphicChance>0.8</alternateGraphicChance>
            <alternateGraphics>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoA</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoB</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoC</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoD</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoE</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoF</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoG</texPath></li>
            </alternateGraphics>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>ReGrowth: Extinct Animals</li>
      <li>ReGrowth Remastered: Extinct Animals</li>
      <li>ReGrowth: Extinct Animals (Continued)</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>/Defs/PawnKindDef[defName = "RG_Dodo"]</xpath>
          <value>
            <alternateGraphicChance>0.8</alternateGraphicChance>
            <alternateGraphics>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoA</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoB</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoC</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoD</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoE</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoF</texPath></li>
              <li><texPath>Things/Pawn/Animal/ReGrowth/Dodo/ExtinctDodoG</texPath></li>
            </alternateGraphics>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
